<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KomgaScraper.App.MatchWindow"
        Title="选择匹配条目"
        Width="1180" Height="620" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, PingFang SC, Segoe UI"
        Background="{DynamicResource AppBgBrush}">
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,310">
            <!-- 左：候选卡片流（按来源分组） -->
            <ScrollViewer Grid.Column="0" Margin="8" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CardsPanel" Spacing="4" />
            </ScrollViewer>

            <!-- 右：详情面板（选之前就能确认是不是这部） -->
            <Border Grid.Column="1" Margin="0,8,8,8" Background="{DynamicResource CardBgBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0" Height="250" Background="{DynamicResource PlaceholderBgBrush}" CornerRadius="6" ClipToBounds="True">
                        <Image x:Name="DetailImage" Stretch="Uniform" />
                    </Border>
                    <TextBox x:Name="DetailMeta" Grid.Row="1" Height="100" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" />
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="DetailSummary" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,12,12">
            <Button x:Name="BtnOk" Content="确认匹配" Classes="primary" MinWidth="110" MinHeight="32" IsEnabled="False" Click="OnOk" />
            <Button x:Name="BtnManual" Content="手动输入 Bangumi 链接/ID…" Classes="app" MinHeight="32" Click="OnManual" />
            <Button x:Name="BtnCancel" Content="取消（不刮削）" Classes="app" MinHeight="32" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>