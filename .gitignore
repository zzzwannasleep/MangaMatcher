# Build artifacts
bin/
obj/
# 注意：写成 dist/ 会把整个目录排除，下面 webdist 的 .gitkeep 白名单就永远不生效
# （git 不会进入被排除的目录）；必须排除「目录内容」才能再白名单具体文件。
**/dist/*
publish/
out/

# Archives
*.zip

# Rider/VS
.idea/
.vs/
*.user
*.suo

# Logs
*.log

# Debug traces
trace-*.txt

# UI audit screenshots（本地验证用，不入库）
.audit/

# ===== Docker/Web 版（komgabangumi-docker 并入本仓库） =====
.toolchain/
data/
server/data/
server/bin/
web/node_modules/
web/dist/
web/.vite/
server/internal/webdist/dist/*
!server/internal/webdist/dist/.gitkeep
*.exe

# 本地参考用的桌面版克隆（正式源码在 src/）
KomgaScraper/
reference/

# 通用
*.zip
.audit/
trace-*.txt
