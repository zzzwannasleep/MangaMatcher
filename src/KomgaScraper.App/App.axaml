<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KomgaScraper.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <!-- 设计令牌：全站统一色板（原 WinForms 版升级版） -->
        <SolidColorBrush x:Key="AccentBrush">#5B5BD6</SolidColorBrush>
        <SolidColorBrush x:Key="AccentSoftBrush">#EDEDFB</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessBrush">#1F8A3B</SolidColorBrush>
        <SolidColorBrush x:Key="WarnBrush">#B26A00</SolidColorBrush>
        <SolidColorBrush x:Key="ErrorBrush">#D13438</SolidColorBrush>
        <SolidColorBrush x:Key="LogBgBrush">#1C1C1E</SolidColorBrush>
        <SolidColorBrush x:Key="LogFgBrush">#B8FFC9</SolidColorBrush>
        <SolidColorBrush x:Key="CardBorderBrush">#D8D8E0</SolidColorBrush>
        <SolidColorBrush x:Key="PanelBgBrush">#FBFBFD</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- ================= 动效体系 ================= -->

        <!-- 窗口淡入：所有窗口统一出生动效 -->
        <Style Selector="Window">
            <Style.Animations>
                <Animation Duration="0:0:0.22" FillMode="Forward">
                    <KeyFrame Cue="0.0">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="1.0">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 按钮：hover 轻浮 + 按压缩放，120ms 缓动（.app 与 .primary 两类按钮都生效） -->
        <Style Selector="Button.app, Button.primary">
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"
                            Easing="CubicEaseOut" />
                    </Transitions>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.app:pointerover, Button.primary:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-1px)" />
        </Style>
        <Style Selector="Button.app:pressed, Button.primary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <!-- 主操作按钮（强调色实心） -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4A4AC4" />
        </Style>

        <!-- 候选卡片：hover 放大 + 阴影浮起，选中强调色描边 -->
        <Style Selector="Border.card">
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"
                            Easing="CubicEaseOut" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    </Transitions>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="BorderBrush" Value="#9E9EF0" />
            <Setter Property="BoxShadow" Value="0 4 14 #22000000" />
        </Style>
        <Style Selector="Border.card.selected">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BoxShadow" Value="0 2 10 #335B5BD6" />
        </Style>

        <!-- 侧栏分组：hover 高亮标题 -->
        <Style Selector="Border.group">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="Margin" Value="1,5,0,2" />
        </Style>

        <!-- 列表行 hover 过渡 -->
        <Style Selector="DataGridRow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!-- 日志框 -->
        <Style Selector="ListBox#LogList">
            <Setter Property="Background" Value="{StaticResource LogBgBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox#LogList ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox#LogList ListBoxItem:nth-child(1)">
            <Setter Property="Foreground" Value="#8FD98F" />
        </Style>

        <!-- 忙碌遮罩：呼吸脉冲 -->
        <Style Selector="Border.busyOverlay">
            <Setter Property="Background" Value="#66FFFFFF" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.busyOverlay.open">
            <Setter Property="IsHitTestVisible" Value="True" />
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite" FillMode="Forward">
                    <KeyFrame Cue="0.0">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="0.5">
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="1.0">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.busySpinner">
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="StrokeDashArray" Value="4,4" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="Ellipse.busySpinner">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0.0">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="1.0">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>